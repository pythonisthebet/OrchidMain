	  <MauiImage Include="Resources\Images\question_mark_icon.png" />
	  <MauiImage Include="Resources\Images\trash_can.png" />
	  <MauiImage Include="Resources\Images\trophy.png" />
	  <MauiImage Include="Resources\Images\up2.png" />
