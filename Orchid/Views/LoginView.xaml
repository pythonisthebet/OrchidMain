<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Orchid.Views.LoginView"
             Title="Login">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20">

            <Label Text="Login" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,20" />

            <!-- Email Input -->
            <Frame BorderColor="LightGray" Padding="10" HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Email" FontAttributes="Bold" />
                    <Entry Text="{Binding Mail}" 
                           Placeholder="email@example.com" 
                           Keyboard="Email" />
                </VerticalStackLayout>
            </Frame>

            <!-- Password Input -->
            <Frame BorderColor="LightGray" Padding="10" HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Password" FontAttributes="Bold" />
                    <Entry Text="{Binding Pass}" 
                           Placeholder="Enter your password" 
                           IsPassword="True" />
                </VerticalStackLayout>
            </Frame>

            <!-- Login Button -->
            <Button Text="Submit Login" 
                    Command="{Binding LoginCommand}" 
                    IsEnabled="{Binding NotInServerCall}" 
                    BackgroundColor="#4CAF50" 
                    TextColor="White"
                    HeightRequest="50"
                    Margin="0,10,0,0" />

            <!-- Sign Up Button -->
            <Button Text="Sign Up" 
                    Command="{Binding SignUpCommand}" 
                    BackgroundColor="#2196F3" 
                    TextColor="White"
                    HeightRequest="50" />

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding InServerCall}" 
                               IsVisible="{Binding InServerCall}" 
                               Color="Red" 
                               HorizontalOptions="Center"
                               Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
