<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Orchid.Views.CharacterSheetPage"
             Title="Character Sheet">

    <Grid Padding="20" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Character Info Header -->
        <StackLayout Grid.Row="0" Orientation="Horizontal" HorizontalOptions="FillAndExpand">
            <Label Text="{Binding CharacterName}" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   HorizontalOptions="StartAndExpand" />

            <Label Text="{Binding ClassAndLevel}" 
                   FontSize="18"
                   HorizontalOptions="End"
                   VerticalOptions="Center" />
        </StackLayout>

        <!-- PDF Viewer -->
        <WebView Grid.Row="1"
                 Source="{Binding PdfFileUri}"
                 HorizontalOptions="FillAndExpand"
                 VerticalOptions="FillAndExpand" />

        <!-- Action Buttons -->
        <Grid Grid.Row="2" ColumnSpacing="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Text="Generate PDF"
                    Command="{Binding GeneratePdfCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="#3498db"
                    TextColor="White" />

            <Button Grid.Column="1"
                    Text="Print PDF"
                    Command="{Binding PrintPdfCommand}"
                    IsEnabled="{Binding CanPrint}"
                    BackgroundColor="#2ecc71"
                    TextColor="White" />
        </Grid>

        <!-- Loading Indicator -->
        <Grid Grid.RowSpan="3" 
              BackgroundColor="#80000000"
              IsVisible="{Binding IsBusy}">
            <StackLayout VerticalOptions="Center" 
                         HorizontalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsBusy}" 
                                   Color="White" 
                                   HeightRequest="50" 
                                   WidthRequest="50" />
                <Label Text="{Binding BusyText}" 
                       TextColor="White" 
                       Margin="0,10,0,0" />
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>