<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Orchid.Views.CharacterSheetPage"
             Title="Character Sheet">

    <Grid Padding="20" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Info Label -->
        <Frame Grid.Row="1"
               BackgroundColor="#f0f0f0"
               CornerRadius="10"
               Padding="15"
               HorizontalOptions="FillAndExpand"
               VerticalOptions="CenterAndExpand"
               Margin="0,20">
            <Label Text="Your PDF has been successfully generated and saved on your device."
                   FontSize="18"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   TextColor="#333333" />
        </Frame>

        <!-- Action Buttons -->
        <Grid Grid.Row="2" ColumnSpacing="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Text="Generate PDF"
                    Command="{Binding GeneratePdfCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="#3498db"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="45" />

            <Button Grid.Column="1"
                    Text="Print PDF"
                    Command="{Binding PrintPdfCommand}"
                    IsEnabled="{Binding CanPrint}"
                    BackgroundColor="#2ecc71"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="45" />
        </Grid>

        <!-- Ban User Button (admin) -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Button Text="Delete Character"
                                Command="{Binding DeleteCommand}"
                                IsEnabled="{Binding IsEnabled}" 
                        Grid.Column="1" 
                        IsVisible="{Binding IsAdmin}"/>
        </Grid>

        <!-- Loading Indicator -->
        <Grid Grid.RowSpan="3" 
              BackgroundColor="#80000000"
              IsVisible="{Binding IsBusy}">
            <StackLayout VerticalOptions="Center" 
                         HorizontalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsBusy}" 
                                   Color="White" 
                                   HeightRequest="50" 
                                   WidthRequest="50" />
                <Label Text="{Binding BusyText}" 
                       TextColor="White" 
                       Margin="0,10,0,0" />
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>
