<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Orchid.Views.AA_raceView"
             Title="AA_raceView">
    <VerticalStackLayout>
        <CollectionView
        x:Name="theCollectionView"
        ItemsLayout="VerticalList"
        SelectionMode="Single"
        
        ItemsSource="{Binding RaceList}"
        SelectedItem="{Binding SelectedRace}"
        SelectionChangedCommand="{Binding SelectionChangedCommand}"
        SelectionChangedCommandParameter="{Binding}">

            <!--SelectedItem="{Binding SelectedItem}"-->


        </CollectionView>

        <Button Text="Confirm" Command="{Binding Confirm}"/>
        <ActivityIndicator IsVisible="{Binding InServerCall}" IsRunning="{Binding InServerCall}" Color="red"></ActivityIndicator>
    </VerticalStackLayout>
</ContentPage>