<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Orchid.Views.AA_imgGeneratorView"
             Title="Image Generator">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="20">

                <Label Text="AI Character Image Generator"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Margin="0,0,0,10" />

                <!-- Info for non-premium users -->
                <Frame BorderColor="LightGray" Padding="15" HasShadow="True" IsVisible="{Binding NotIsPremium}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Generate a default character image"
                               FontAttributes="Bold"
                               FontSize="18" />
                        <Label Text="Unlock premium to access advanced image generation with AI."
                               FontSize="14"
                               TextColor="Gray" />
                        <Button Text="Generate Default Image"
                                Command="{Binding DefaultGenerate}"
                                IsEnabled="{Binding NotInServerCall}"
                                BackgroundColor="#607D8B"
                                TextColor="White"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Premium user interface -->
                <Frame BorderColor="LightGray" Padding="15" HasShadow="True" IsVisible="{Binding IsPremium}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="You're a Premium Member!"
                               FontAttributes="Bold"
                               FontSize="18" />
                        <Label Text="Describe your character in detail for the best AI results:"
                               FontSize="14"
                               TextColor="Gray" />
                        <Entry Placeholder="e.g., Elf ranger with silver hair and a bow..."
                               Text="{Binding PromptText}" />
                        <Button Text="Generate Premium Image"
                                Command="{Binding ChatGenerate}"
                                IsEnabled="{Binding NotInServerCall}"
                                BackgroundColor="#FFB300"
                                TextColor="White"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Generated image section -->
                <Frame BorderColor="LightGray" Padding="15" HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Generated Character Image"
                               FontAttributes="Bold"
                               FontSize="18"
                               HorizontalOptions="Center" />
                        <Image Source="{Binding ImageURL}" 
                               HeightRequest="300"
                               Aspect="AspectFill"
                               Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading overlay -->
        <Grid BackgroundColor="#80000000" IsVisible="{Binding InServerCall}">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="{Binding InServerCall}" 
                                   Color="White" 
                                   HeightRequest="50" 
                                   WidthRequest="50"/>
                <Label Text="Generating image..." 
                       TextColor="White" 
                       Margin="0,10,0,0"/>
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>
