<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Orchid.Views.StartPage"
             Title="StartPage">
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20">

            <!-- App Title -->
            <Frame BackgroundColor="#6A1B9A" 
                   HasShadow="True" 
                   CornerRadius="12" 
                   Padding="20,10" 
                   Margin="0,0,0,10"
                   HorizontalOptions="Center">
                <Label Text="Orchid" 
                       FontSize="32" 
                       FontAttributes="Bold" 
                       TextColor="White"
                       HorizontalOptions="Center" />
            </Frame>
            
            <!-- App Image -->
            <Image Source="dnd_image.png" 
                   HorizontalOptions="Center"
                   HeightRequest="200"
                   WidthRequest="200"
                   Margin="0,0,0,20"/>

            <!-- App Description -->
            <Frame BorderColor="LightGray" Padding="15" HasShadow="True" Margin="0,0,0,20">
                <Label Text="Effortless D&amp;D character creation at your fingertips"
                       HorizontalOptions="Center"
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       TextColor="#555555" />
            </Frame>

            <!-- Login Button -->
            <Frame BackgroundColor="#4CAF50" 
                   HasShadow="True" 
                   CornerRadius="8" 
                   Padding="0" 
                   Margin="0,10,0,0">
                <Button Text="Login"
                        Command="{Binding LoginCommand}"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        HeightRequest="50"
                        FontAttributes="Bold"
                        FontSize="16" />
            </Frame>

            <!-- Sign Up Button -->
            <Frame BackgroundColor="#2196F3" 
                   HasShadow="True" 
                   CornerRadius="8" 
                   Padding="0">
                <Button Text="Sign Up"
                        Command="{Binding SignUpCommand}"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        HeightRequest="50"
                        FontAttributes="Bold"
                        FontSize="16" />
            </Frame>

            <!-- Contact Info -->
            <Frame BorderColor="LightGray" Padding="10" HasShadow="True" Margin="0,20,0,0">
                <Label Text="Contact us at noamhaner@gmail.com :)"
                       HorizontalOptions="Center"
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalTextAlignment="Center" />
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>