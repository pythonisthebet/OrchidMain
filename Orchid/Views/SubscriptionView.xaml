<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Orchid.Views.SubscriptionView"
             Title="SubscriptionView">
    <VerticalStackLayout>
        <Grid Padding="30" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" Text="For Only 1.99$!" FontSize="Title"/>
            <Label Padding="2" Grid.Row="1" Text="-Generating images in the app!"/>
            <Button Grid.Row="2" Text="Pay" Command="{Binding PayCommand}" CommandParameter="1.99"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>