<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Orchid.Views.AA_featsView"
             Title="AA_featsView">
    <VerticalStackLayout>
        <Grid Margin="10">
            <CollectionView
        x:Name="theCollectionView"
        ItemsLayout="VerticalList"
        SelectionMode="Multiple"
    
        ItemsSource="{Binding FeatList}"
        SelectedItems="{Binding SelectedFeats, Mode=TwoWay}"
        SelectionChangedCommand="{Binding SelectionChangedCommand}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="5">
                            <Label
                        Text="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <!--SelectedItem="{Binding SelectedItem}"-->


            </CollectionView>
        </Grid>
        <Button Text="Confirm" Command="{Binding Confirm}" IsEnabled="{Binding IsNotEmpty}"/>
        <ActivityIndicator IsVisible="{Binding InServerCall}" IsRunning="{Binding InServerCall}" Color="red"></ActivityIndicator>
    </VerticalStackLayout>
</ContentPage>