<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Orchid.Views"
             x:Class="Orchid.Views.BrowseView"
             Title="Browse">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Autocomplete -->
            <Label Text="Type something (word-by-word autocomplete):" FontAttributes="Bold" />
            <Border Stroke="#ccc" StrokeThickness="1" StrokeShape="RoundRectangle 10,10,10,10" Padding="10">
                <ContentView x:Name="AutoCompleteContainer" />
            </Border>

            <!-- Search Button -->
            <Button Text="Search" 
                    Command="{Binding Search}" 
                    IsEnabled="{Binding NotInServerCall}" 
                    BackgroundColor="#58CCED"
                    TextColor="White"
                    CornerRadius="10" />

            <!-- Character Collection -->
            <CollectionView ItemsSource="{Binding CharacterList}" 
                            SelectedItem="{Binding SelectedChar}"
                            SelectionMode="Single">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" BackgroundColor="#F4F4F4" Margin="5">
                            <Label Text="{Binding CharacterName}" 
                                   FontAttributes="Bold" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Select Button -->
            <Button Text="Select" 
                    Command="{Binding Select}" 
                    IsEnabled="{Binding NotInServerCall}" 
                    BackgroundColor="#4CAF50" 
                    TextColor="White"
                    CornerRadius="10" />

            <!-- Loading Indicator Again -->
            <ActivityIndicator IsVisible="{Binding InServerCall}" 
                               IsRunning="{Binding InServerCall}" 
                               Color="Red" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
